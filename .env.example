# When VITE_BASE_URL is set, in-person booking uses real BookingPanel APIs.
# Leave unset to keep the in-memory sample adapter.
VITE_BASE_URL=https://stage-gateway.tapsi.doctor

# Bearer token (or store accessToken in localStorage, same key as physician-panel).
VITE_ACCESS_TOKEN=

# Optional doctor recId. When empty, GET Panel/Doctor/GetDoctor is used.
VITE_PROVIDER_ID=
